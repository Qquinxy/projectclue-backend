PORT=5000
MONGODB_URI=mongodb://localhost:27017/university_club_system
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# --- Email verification (real SMTP delivery) ---
# Required for registration: a new account cannot log in until the emailed
# verification link is opened. Fill these in your local .env only — never
# commit real credentials.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<your@gmail.com>,
# SMTP_PASSWORD=<16-character Google App Password, not your normal password>
SMTP_HOST=
SMTP_PORT=587
# Optional. Leave empty to infer from the port (465 = implicit TLS, else STARTTLS).
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ProjectClue <no-reply@example.com>
