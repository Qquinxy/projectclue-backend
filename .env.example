PORT=5000
MONGODB_URI=mongodb://localhost:27017/university_club_system
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# --- Google OAuth (direct Google sign-in) ---
# From https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: full callback URL e.g. https://api.yourdomain.com/api/auth/google/callback.
# Leave empty to derive it from the request (works on localhost and behind a proxy).
GOOGLE_REDIRECT_URI=
